{
   "chrome_url_overrides": {
      "newtab": "newtab/index.html"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Live wallpapers and shortcuts on every new tab.",
   "icons": {
      "128": "assets/icons/icon128.png",
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Beautiful Chrome Theme",
   "action": { "default_title": "Beautiful Chrome Theme" },
   "background": { "service_worker": "icon-worker.js" },
   "optional_host_permissions": [ "https://wttr.in/*" ],
   "permissions": [ "storage" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "1.1.0"
}
